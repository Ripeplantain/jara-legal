# Copy to .env and fill in. Never prefix these with NEXT_PUBLIC_.

# SQLite database file (Docker mounts /data as a volume).
DATABASE_PATH=./data/app.db

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OpenRouter (https://openrouter.ai/keys). The model must support tool calling.
OPENROUTER_API_KEY=0513aad09db68586a7a7ab6595fb2e5e0879fd121e206d5a8646d2674dc3a767
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
